*.pyd
*.pyw
*.pyz
server/.env
server/instance/
*.db
*.sqlite3

# ─── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
